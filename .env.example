# Groq API Key (Recommended LLM engine: llama-3.3-70b-versatile)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key (Alternative LLM engine)
OPENAI_API_KEY=your_openai_api_key_here

# Tavily API Key (Optional: Required for web research functionality)
TAVILY_API_KEY=your_tavily_api_key_here

# Pollinations API Key (Optional: For AI image generation)
POLLINATIONS_API_KEY=your_pollinations_api_key_here

# Google Gemini API Key (Optional: Required for Gemini models & diagrams)
GOOGLE_API_KEY=your_google_api_key_here

# LangSmith Tracing & Observability (Optional)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY="your_langsmith_api_key_here"
LANGCHAIN_PROJECT=blog-writing-multi-agent
