# ==========================================
# ✍️ Project 1: AI Blog Writing Agent - Environment Variables
# ==========================================

# Groq API Keys (Required for LLM content generation)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Multi-Account / Multi-Key Rotation & Fallback Pool (Optional: Load balance parallel requests across keys)
GROQ_API_KEY_ACCOUNT_1=your_groq_api_key_account_1
GROQ_API_KEY_ACCOUNT_2=your_groq_api_key_account_2
GROQ_API_KEY_ACCOUNT_3=your_groq_api_key_account_3
GROQ_API_KEY_ACCOUNT_4=your_groq_api_key_account_4

# Groq Model override (Optional: e.g. qwen/qwen3.8-27b, openai/gpt-oss-120b, llama-3.3-70b-versatile)
GROQ_MODEL=qwen/qwen3.8-27b

# Request Rate Limit Interval in seconds per key slot (Default: 0.5)
GROQ_MIN_REQUEST_INTERVAL=0.5

# Tavily API Key (Required for web research agent)
# Get a free key at https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Pollinations AI API Key (Optional: for technical diagram/visual generation)
POLLINATIONS_API_KEY=your_pollinations_api_key_here

# Google Gemini API Key (Optional: alternative diagram generator)
GOOGLE_API_KEY=your_google_api_key_here

# LangChain Tracing & Observability (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=ai-blog-writing-agent
