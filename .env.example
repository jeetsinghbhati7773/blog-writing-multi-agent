# ==========================================
# ✍️ Project 1: AI Blog Writing Agent - Environment Variables
# ==========================================

# Groq API Key (Required for LLM content generation)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq Model override (Optional: defaults to llama-3.3-70b-versatile or qwen-2.5-32b)
GROQ_MODEL=llama-3.3-70b-versatile

# Tavily API Key (Required for web research agent)
# Get a free key at https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Pollinations AI API Key (Optional: for technical diagram/visual generation)
POLLINATIONS_API_KEY=your_pollinations_api_key_here

# Google Gemini API Key (Optional: alternative diagram generator)
GOOGLE_API_KEY=your_google_api_key_here

# LangChain Tracing & Observability (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=ai-blog-writing-agent
