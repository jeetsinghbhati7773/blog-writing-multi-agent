# Groq API Key & Model (Active Groq models: openai/gpt-oss-120b, qwen/qwen3.6-27b, openai/gpt-oss-20b)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# OpenAI API Key (Alternative LLM engine)
OPENAI_API_KEY=your_openai_api_key_here

# Tavily API Key (Optional: Required for web research functionality)
TAVILY_API_KEY=your_tavily_api_key_here

# Pollinations API Key (Optional: For AI image generation)
POLLINATIONS_API_KEY=your_pollinations_api_key_here

# Google Gemini API Key (Optional: Required for Gemini models & diagrams)
GOOGLE_API_KEY=your_google_api_key_here

# Alpha Vantage API Key (Optional: for the stock-price MCP/chat tool)
# Get a free key at https://www.alphavantage.co/support/#api-key
# Falls back to the public "demo" key (only works for sample symbols) if unset.
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# LangSmith Tracing & Observability (Optional)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY="your_langsmith_api_key_here"
LANGCHAIN_PROJECT=blog-writing-multi-agent

# Supabase & PostgreSQL (Multi-User, Expense Storage, Multiple Chats, Long-Term Memory)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key
DATABASE_URL=postgresql://postgres:yourpassword@db.yourproject.supabase.co:5432/postgres

